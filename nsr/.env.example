# ── Core ─────────────────────────────────────────────────────────────────────
# Secret used by Payload to sign tokens (auth, captcha challenge). Generate a
# long random string for every environment, never commit the real value.
#   openssl rand -hex 32
PAYLOAD_SECRET=change-me

# SQLite database (libSQL URI).
#   local dev : file:./nsr.db  (a file in the project root)
#   docker    : file:/app/data/nsr.db  (the mounted volume — see docker-compose)
DATABASE_URI=file:./nsr.db

# Public URL of the site.
#   local dev  : http://localhost:3010
#   production : https://neser.sk
NEXT_PUBLIC_SERVER_URL=http://localhost:3010

# ── Deployment (docker-compose) ──────────────────────────────────────────────
# Host directory holding persistent data (SQLite DB + uploaded media).
# Defaults to ./data next to docker-compose.yml. Point it at a stable path in
# production, e.g. /home/kovo/docker/volumes/neser
# DATA_DIR=/home/kovo/docker/volumes/neser

# nginx-proxy + acme-companion (Let's Encrypt). These are consumed by the shared
# proxy/companion containers on the `nginx-proxy` network — they route the
# domain to this container and provision its TLS certificate. The app container
# just needs to advertise them and join the network.
# VIRTUAL_HOST=neser.sk
# VIRTUAL_PORT=3000
# LETSENCRYPT_HOST=neser.sk
# LETSENCRYPT_EMAIL=kovo.mato@gmail.com